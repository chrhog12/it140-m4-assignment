Import random  

user = input() 

low = int(input()) 

high  = int(input()) 

If low >= high: 

	Print(“please try again”) 

	Low = int(input()) 

	High = int(input()) 

Random_num = randint(low, high) 

Print(user, “let’s play a random number game.”) 

User_guess = int(input()) 

If userguess > random_num: 

	Print(“That is the wrong number. Try again”) 

	User_guess = int(input()) 

Elif userguess < random_num: 

	print (“That is the wrong number. Try again”) 

	User_guess = int(input()) 

Elif userguess == random_num: 

	Print(“Thats the correct number!”) 
